# ---- Attestation -------------------------------------------------
# This file, when committed, is a signed declaration of conformance
# state. A ledger entry (specification 03) may be produced per
# declaration change.
attestation:
  declaration_hash: null                              # Computed by CI; SHA-256 of this file
                                                      # excluding the attestation block
  declaration_ledger_entry_id: null                   # Set when the declaration is
                                                      # recorded on the contract ledger
  signed_by:
    - did: "did:web:example.com:users:architect-owner"
      signature: null                                 # Set on commit by signing hook
    - did: "did:web:example.com:governance:owner-primary"
      signature: null
  signed_at: null
