{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epas-platform.github.io/spec/2.1/schemas/profile-catalog.schema.json",
  "title": "EPAS v2.1 Profile Catalog",
  "type": "object",
  "required": [
    "schema_version",
    "catalog_id",
    "title",
    "status",
    "owner",
    "updated_at",
    "bundles"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^epas\\.profile-catalog/2\\.1(?:-[A-Za-z0-9._-]+)?$"
    },
    "catalog_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated", "superseded"]
    },
    "owner": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string"
    },
    "bundles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "bundle_id",
          "status",
          "description",
          "composed_from",
          "reference_stack_family"
        ],
        "properties": {
          "bundle_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "status": {
            "type": "string",
            "enum": ["draft", "active", "deprecated", "superseded"]
          },
          "description": {
            "type": "string"
          },
          "composed_from": {
            "type": "object",
            "required": [
              "lifecycle",
              "audience",
              "environment",
              "governance",
              "infrastructure",
              "data_model",
              "delivery",
              "architecture"
            ],
            "properties": {
              "lifecycle": {
                "type": "string",
                "enum": ["prototype", "demo", "mvp", "production"]
              },
              "audience": {
                "type": "string",
                "enum": ["internal_tool", "internal_platform", "customer_facing", "partner_embedded"]
              },
              "environment": {
                "type": "string",
                "enum": ["local_dev", "preview", "shared_dev", "staging_uat", "production"]
              },
              "governance": {
                "type": "string",
                "enum": ["g0_exploratory", "g1_guided", "g2_operational", "g3_assured"]
              },
              "infrastructure": {
                "type": "string",
                "enum": ["i0_local_compose", "i1_simple_runtime", "i2_platform_runtime", "i3_enterprise_multi_env"]
              },
              "data_model": {
                "type": "string",
                "enum": ["relational_operational", "entity_relationship_native", "hybrid_multimodal"]
              },
              "delivery": {
                "type": "string",
                "enum": ["ui_first", "api_first", "sdk_first", "agent_first", "integration_first"]
              },
              "architecture": {
                "type": "string",
                "enum": ["single_service", "modular_monolith", "service_oriented"]
              },
              "architecture_traits": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["event_driven", "edge_capable"]
                },
                "uniqueItems": true
              },
              "overlays": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["regulated", "edge", "entity_native_agentic", "customer_data_sensitive"]
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          },
          "reference_stack_family": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
