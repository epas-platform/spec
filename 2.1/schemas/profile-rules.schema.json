{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epas-platform.github.io/spec/2.1/schemas/profile-rules.schema.json",
  "title": "EPAS v2.1 Profile Rules",
  "type": "object",
  "required": [
    "schema_version",
    "policy_id",
    "title",
    "status",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^epas\\.profile-rules/2\\.1(?:-[A-Za-z0-9._-]+)?$"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated", "superseded"]
    },
    "description": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "severity", "applies_to", "when", "then"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "description": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": ["error", "warning", "info"]
          },
          "applies_to": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "profile",
                "classification",
                "controls",
                "technology",
                "reference_stack",
                "conformance"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "when": {
            "type": "string"
          },
          "then": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
